            "text": "{\"status\":200,\"data\":{\"id\":209,\"vendor\":{\"id\":11582,\"name\":\"ADITYA AWASTHI\",\"emailId\":\"awasthi1008@gmail.com\",\"phoneNo\":\"9823648232\",\"gstNumber\":\"IUW823874689279\",\"uniqueAccountCode\":\"ADI//11582\",\"addressResponse\":[{\"id\":11954,\"addressLine1\":\"PLOT 872\",\"addressLine2\":\"PHASE V\",\"city\":\"GURUGRAM\",\"stateName\":\"HARYANA\",\"countryName\":\"INDIA\",\"pincode\":\"876349\",\"primaryNumber\":\"9893492834\",\"secondaryNumber\":\"\",\"gstNumber\":\"IUW823874689279\",\"stateId\":14,\"isActive\":true},{\"id\":11955,\"addressLine1\":\"Plot 123\",\"addressLine2\":\"xyz\",\"city\":\"Bhopal\",\"stateName\":\"MADHYA PRADESH\",\"countryName\":\"INDIA\",\"pincode\":\"462001\",\"primaryNumber\":\"8709979282\",\"secondaryNumber\":\"\",\"gstNumber\":\"afshdgsgdjdgshj\",\"stateId\":23,\"isActive\":true}],\"bankDetailsResponse\":[{\"id\":8604,\"accountNumber\":\"238999232923\",\"ifscCode\":\"SBI90777W77\",\"bankName\":\"SBI\",\"accountHolderName\":\"ADITYA\",\"isDefault\":true,\"isActive\":true}],\"accountMasterTypeDto\":{\"id\":1,\"name\":\"Vendor\",\"description\":\"Vendor\"},\"personDetailsList\":{\"id\":11596,\"name\":\"ADITYA \",\"emailId\":\"\",\"phoneNo\":\"9238489375\",\"gender\":\"Male\",\"aadharNumber\":\"\",\"panNumber\":\"YHUJU8763E\",\"isActive\":true,\"createdBy\":null,\"updatedBy\":null,\"msmeNo\":null,\"countryCodeId\":null},\"msmeNo\":null,\"selectedAddressId\":11954,\"completeSelectedAddress\":\"PLOT 872 PHASE V, INDIA, HARYANA\",\"selectedVendorBankDetailsId\":8604,\"selectedVendorBankDetails\":\"SBI, 238999232923, ADITYA, SBI90777W77\"},\"poNo\":\"PNM_PURCHASEORDERDEMO SITE/116\",\"draftSerialNo\":null,\"isActive\":true,\"isGlobalPurchaseOrder\":null,\"totalAmount\":279.0,\"totalTaxAmount\":59.0,\"freight\":100.0,\"freightGst\":10.0,\"freightType\":{\"id\":1,\"freightType\":\"VALUE\",\"isKnownFreight\":true},\"stateId\":10,\"isEditable\":false,\"isDeletable\":false,\"isFinalState\":false,\"trips\":null,\"isHired\":false,\"categoryId\":null,\"categoryName\":null,\"refNo\":\"9786543\",\"withoutRate\":false,\"purchaseOrderDate\":\"2026-11-16T00:00:00.000+00:00\",\"expectedDeliveryDate\":\"2026-11-30T00:00:00.000+00:00\",\"store\":{\"storeId\":1,\"id\":null,\"storeName\":\"Demo\",\"name\":null,\"storeInchargeId\":3,\"storeInchargeName\":\"System Admin\",\"storeInchargeNo\":\"7656489763\",\"storeAddress\":[],\"isRackAvailable\":false,\"gstNo\":\"\",\"racks\":null},\"tcsAmount\":10.0,\"subject\":\"uytrersdfcgv\",\"scopeOfSupply\":\"\",\"dispatchMode\":\"kljhgfd\",\"purchaseOrderFiles\":[{\"id\":132,\"isActive\":true,\"documentType\":null,\"amazonAwsS3Response\":{\"id\":105548,\"name\":\"file-sample_150kB.pdf\",\"modifiedName\":null,\"path\":\"https://utilitys3staging.nyggs.com/files/file/90cf6ef1edc0288be42e8b73caf7a6\",\"bucket\":null,\"moduleId\":1,\"siteId\":null,\"companyId\":1,\"isActive\":true,\"createdOn\":\"2026-11-16T06:11:32.000+00:00\",\"createdBy\":3,\"createdByType\":true,\"fileSize\":null}}],\"purchaseOrderItemTaxes\":[{\"id\":4,\"tax\":{\"id\":1,\"taxName\":\"DEMO\",\"isActive\":true},\"taxPercentage\":1.0,\"taxAmount\":100.0,\"taxAction\":1,\"isActive\":true,\"accountTypeId\":null,\"accountId\":null}],\"purchaseOrderItems\":[{\"id\":284,\"machineryCategory\":{\"id\":138,\"name\":\"FARANA\",\"isPlant\":false},\"requestedQuantity\":10.0,\"approvedQuantity\":10.0,\"rate\":5.0,\"amount\":50.0,\"tolerance\":10.0,\"gst\":18.0,\"gstAmount\":9.0,\"scGst\":9.0,\"scGstAmount\":4.5,\"cGst\":9.0,\"cGstAmount\":4.5,\"isPoRateZero\":false,\"productInfo\":\"test\",\"remainingQuantity\":10.0,\"itemCategoryIds\":[],\"type\":{\"id\":1,\"name\":null,\"isActive\":null},\"machineType\":{\"id\":1,\"name\":\"Equipment\"},\"remarks\":\"\",\"manufacturer\":{\"id\":169,\"name\":\"Blackrock Engieering Private Limited\",\"modelResponse\":{\"id\":412,\"name\":\"Machine-TM10\",\"manufacturerId\":null,\"isActive\":true},\"isActive\":true},\"model\":{\"id\":412,\"name\":\"Machine-TM10\",\"isActive\":true},\"subPlantDescription\":\"\",\"hsnCode\":\"84264100\",\"remaingGateEntryQty\":10.0,\"poDate\":\"2026-11-16T00:00:00.000+00:00\"}],\"purchaseOrderTermsAndConditionResponse\":{\"termsConditionId\":3,\"termsConditionName\":\"Diesel Purchase Order\",\"content\":\"<h2 data-start=\\\"179\\\" data-end=\\\"198\\\"><span style=\\\"font-family: &quot;times new roman&quot;, times, serif; font-size: 14px;\\\">1. Payment Terms</span></h2>\\n<ol data-start=\\\"199\\\" data-end=\\\"389\\\">\\n<li data-start=\\\"199\\\" data-end=\\\"331\\\">\\n<p data-start=\\\"202\\\" data-end=\\\"331\\\"><span style=\\\"font-family: &quot;times new roman&quot;, times, serif; font-size: 14px;\\\">Diesel payment shall be made in advance as per the Purchase Order. Transportation payment shall be made after delivery at site.</span></p>\\n</li>\\n<li data-start=\\\"332\\\" data-end=\\\"389\\\">\\n<p data-start=\\\"335\\\" data-end=\\\"389\\\"><span style=\\\"font-family: &quot;times new roman&quot;, times, serif; font-size: 14px;\\\">Retention / Security Deposit: <strong data-start=\\\"365\\\" data-end=\\\"388\\\">Not Applicable (NA)</strong>.</span></p>\\n</li>\\n</ol>\\n<h2 data-start=\\\"391\\\" data-end=\\\"416\\\"><span style=\\\"font-family: &quot;times new roman&quot;, times, serif; font-size: 14px;\\\">2. Packing &amp; Transport</span></h2>\\n<ol data-start=\\\"417\\\" data-end=\\\"583\\\">\\n<li data-start=\\\"417\\\" data-end=\\\"491\\\">\\n<p data-start=\\\"420\\\" data-end=\\\"491\\\"><span style=\\\"font-family: &quot;times new roman&quot;, times, serif; font-size: 14px;\\\">Materials must be properly packed to avoid any damage during transit.</span></p>\\n</li>\\n<li data-start=\\\"492\\\" data-end=\\\"583\\\">\\n<p data-start=\\\"495\\\" data-end=\\\"583\\\"><span style=\\\"font-family: &quot;times new roman&quot;, times, serif; font-size: 14px;\\\">Transit insurance shall be the responsibility of the transporter until delivery at site.</span></p>\\n</li>\\n</ol>\\n<h2 data-start=\\\"585\\\" data-end=\\\"608\\\"><span style=\\\"font-family: &quot;times new roman&quot;, times, serif; font-size: 14px;\\\">3. Quality Assurance</span></h2>\\n<ol data-start=\\\"609\\\" data-end=\\\"859\\\">\\n<li data-start=\\\"609\\\" data-end=\\\"697\\\">\\n<p data-start=\\\"612\\\" data-end=\\\"697\\\"><span style=\\\"font-family: &quot;times new roman&quot;, times, serif; font-size: 14px;\\\">Materials must conform to the applicable IS standards and technical specifications.</span></p>\\n</li>\\n<li data-start=\\\"698\\\" data-end=\\\"773\\\">\\n<p data-start=\\\"701\\\" data-end=\\\"773\\\"><span style=\\\"font-family: &quot;times new roman&quot;, times, serif; font-size: 14px;\\\">Rejected materials shall be removed and replaced at the vendor's cost.</span></p>\\n</li>\\n<li data-start=\\\"774\\\" data-end=\\\"859\\\">\\n<p data-start=\\\"777\\\" data-end=\\\"859\\\"><span style=\\\"font-family: &quot;times new roman&quot;, times, serif; font-size: 14px;\\\">Test certificates / manufacturer's warranty shall be provided wherever applicable.</span></p>\\n</li>\\n</ol>\\n<h2 data-start=\\\"861\\\" data-end=\\\"881\\\"><span style=\\\"font-family: &quot;times new roman&quot;, times, serif; font-size: 14px;\\\">4. Taxes &amp; Duties</span></h2>\\n<ol data-start=\\\"882\\\" data-end=\\\"1038\\\">\\n<li data-start=\\\"882\\\" data-end=\\\"955\\\">\\n<p data-start=\\\"885\\\" data-end=\\\"955\\\"><span style=\\\"font-family: &quot;times new roman&quot;, times, serif; font-size: 14px;\\\">GST and other statutory duties shall be charged extra as applicable.</span></p>\\n</li>\\n<li data-start=\\\"956\\\" data-end=\\\"1038\\\">\\n<p data-start=\\\"959\\\" data-end=\\\"1038\\\"><span style=\\\"font-family: &quot;times new roman&quot;, times, serif; font-size: 14px;\\\">The vendor must mention the GST number, HSN code, and PO number on the invoice.</span></p>\\n</li>\\n</ol>\\n<h2 data-start=\\\"1040\\\" data-end=\\\"1067\\\"><span style=\\\"font-family: &quot;times new roman&quot;, times, serif; font-size: 14px;\\\">5. Risk &amp; Responsibility</span></h2>\\n<ol data-start=\\\"1068\\\" data-end=\\\"1261\\\">\\n<li data-start=\\\"1068\\\" data-end=\\\"1210\\\">\\n<p data-start=\\\"1071\\\" data-end=\\\"1210\\\"><span style=\\\"font-family: &quot;times new roman&quot;, times, serif; font-size: 14px;\\\">In case of delay or default, the Company reserves the right to procure the material from alternate sources at the vendor's risk and cost.</span></p>\\n</li>\\n<li data-start=\\\"1211\\\" data-end=\\\"1261\\\">\\n<p data-start=\\\"1214\\\" data-end=\\\"1261\\\"><span style=\\\"font-family: &quot;times new roman&quot;, times, serif; font-size: 14px;\\\">Any shortage shall be borne by the transporter.</span></p>\\n</li>\\n</ol>\\n<h2 data-start=\\\"1263\\\" data-end=\\\"1286\\\"><span style=\\\"font-family: &quot;times new roman&quot;, times, serif; font-size: 14px;\\\">6. Penalty for Delay</span></h2>\\n<ol data-start=\\\"1287\\\" data-end=\\\"1401\\\">\\n<li data-start=\\\"1287\\\" data-end=\\\"1401\\\">\\n<p data-start=\\\"1290\\\" data-end=\\\"1401\\\"><span style=\\\"font-family: &quot;times new roman&quot;, times, serif; font-size: 14px;\\\">Kaluwala Construction Private Limited reserves the right to impose a penalty for delayed delivery of materials.</span></p>\\n</li>\\n</ol>\\n<h2 data-start=\\\"1403\\\" data-end=\\\"1427\\\"><span style=\\\"font-family: &quot;times new roman&quot;, times, serif; font-size: 14px;\\\">7. Insurance &amp; Safety</span></h2>\\n<ol data-start=\\\"1428\\\" data-end=\\\"1587\\\">\\n<li data-start=\\\"1428\\\" data-end=\\\"1512\\\">\\n<p data-start=\\\"1431\\\" data-end=\\\"1512\\\"><span style=\\\"font-family: &quot;times new roman&quot;, times, serif; font-size: 14px;\\\">The vendor shall be responsible for the safe delivery of materials to the site.</span></p>\\n</li>\\n<li data-start=\\\"1513\\\" data-end=\\\"1587\\\">\\n<p data-start=\\\"1516\\\" data-end=\\\"1587\\\"><span style=\\\"font-family: &quot;times new roman&quot;, times, serif; font-size: 14px;\\\">Any accident or damage during delivery shall be the vendor's liability.</span></p>\\n</li>\\n</ol>\\n<h2 data-start=\\\"1589\\\" data-end=\\\"1606\\\"><span style=\\\"font-family: &quot;times new roman&quot;, times, serif; font-size: 14px;\\\">8. Termination</span></h2>\\n<ol data-start=\\\"1607\\\" data-end=\\\"1734\\\">\\n<li data-start=\\\"1607\\\" data-end=\\\"1734\\\">\\n<p data-start=\\\"1610\\\" data-end=\\\"1734\\\"><span style=\\\"font-family: &quot;times new roman&quot;, times, serif; font-size: 14px;\\\">The Company may cancel the Purchase Order in case of vendor non-compliance, poor quality of materials, or delay in delivery.</span></p>\\n</li>\\n</ol>\\n<h2 data-start=\\\"1736\\\" data-end=\\\"1768\\\"><span style=\\\"font-family: &quot;times new roman&quot;, times, serif; font-size: 14px;\\\">9. Arbitration &amp; Jurisdiction</span></h2>\\n<ol data-start=\\\"1769\\\" data-end=\\\"1960\\\">\\n<li data-start=\\\"1769\\\" data-end=\\\"1960\\\">\\n<p data-start=\\\"1772\\\" data-end=\\\"1960\\\"><span style=\\\"font-family: &quot;times new roman&quot;, times, serif; font-size: 14px;\\\">Any dispute arising out of this Purchase Order shall be subject to arbitration as per the Arbitration &amp; Conciliation Act, 1996. Jurisdiction shall be limited to the applicable courts only.</span></p>\\n</li>\\n</ol>\\n<h2 data-start=\\\"1962\\\" data-end=\\\"1979\\\"><span style=\\\"font-family: &quot;times new roman&quot;, times, serif; font-size: 14px;\\\">10. Acceptance</span></h2>\\n<ol data-start=\\\"1980\\\" data-end=\\\"2326\\\">\\n<li data-start=\\\"1980\\\" data-end=\\\"2084\\\">\\n<p data-start=\\\"1983\\\" data-end=\\\"2084\\\"><span style=\\\"font-family: &quot;times new roman&quot;, times, serif; font-size: 14px;\\\">We hereby accept the above Purchase Order along with all the terms and conditions mentioned herein.</span></p>\\n</li>\\n<li data-start=\\\"2085\\\" data-end=\\\"2134\\\">\\n<p data-start=\\\"2088\\\" data-end=\\\"2134\\\"><span style=\\\"font-family: &quot;times new roman&quot;, times, serif; font-size: 14px;\\\">This Purchase Order is issued in two copies.</span></p>\\n</li>\\n<li data-start=\\\"2135\\\" data-end=\\\"2270\\\">\\n<p data-start=\\\"2138\\\" data-end=\\\"2270\\\"><span style=\\\"font-family: &quot;times new roman&quot;, times, serif; font-size: 14px;\\\">The agency shall return the original and duplicate copies duly signed on all pages and affixed with seal as a token of acceptance.</span></p>\\n</li>\\n<li data-start=\\\"2271\\\" data-end=\\\"2326\\\">\\n<p data-start=\\\"2274\\\" data-end=\\\"2326\\\"><span style=\\\"font-family: &quot;times new roman&quot;, times, serif; font-size: 14px;\\\">The duplicate copy shall be treated as the sub-copy.</span></p></li></ol>\"},\"gateEntryByPoIdResponses\":null,\"rfqId\":null,\"rfqNumber\":null,\"isPoFromRfq\":null,\"isPoWithoutIndent\":false,\"globalPurchaseOrderResponses\":null,\"hiredDays\":null,\"defaultTermAndCondition\":null,\"siteId\":1554,\"isItemGstIncluded\":false,\"addressTagWithPoResponseDtosList\":[{\"id\":303,\"addressId\":9450,\"completeAddress\":\"1, B-3/5, CINEPOLIS MALL ROAD, Vibhuti, Khand, Lucknow,, Lucknow, UTTAR PRADESH, INDIA, (gstNo-09AAKFN8676M1Z8)\",\"isActive\":true,\"stateId\":34,\"selectedAddressGst\":\"09AAKFN8676M1Z8\"},{\"id\":6786,\"addressId\":11954,\"completeAddress\":\"PLOT 872, PHASE V, GURUGRAM,HARYANA,INDIA (gstNo-IUW823874689279)\",\"isActive\":true,\"stateId\":14,\"selectedAddressGst\":\"IUW823874689279\"}],\"billingAddressResponse\":{\"billingSiteId\":1554,\"billingSiteName\":\"DEMO SITE\",\"stateDetailsResponse\":{\"id\":14,\"name\":\"HARYANA\",\"stateCode\":\"06\",\"isActive\":null},\"siteGst\":\"KULLU\",\"sitecode\":\"DEM-KA\",\"billingAddress\":\"NKC Projects Pvt. Ltd.</b>,Village - Jia, Dist. Kullu (H.P)\"},\"needToShowRejectWateMark\":false,\"needToShowForcedClosedWaterMark\":false,\"isNeedToShowheaderFooter\":true,\"eng