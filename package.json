{
  "name": "pnm-automation",
  "version": "1.0.0",
  "description": "PNM - Playwright End-to-End Test Suite",
  "main": "index.js",
  "scripts": {
    "test": "npx playwright test",
    "test:smoke": "npx playwright test --grep @smoke",
    "test:regression": "npx playwright test --grep @regression",
    "test:login": "npx playwright test tests/login/",
    "test:api": "npx playwright test tests/api/pnm_master tests/api/pnm_dashboard tests/api/pnm_asset tests/api/pnm_procurement tests/api/pnm_service_dpr tests/api/pnm_report --workers=2",
    "test:api:master": "npx playwright test tests/api/pnm_master --workers=2",
    "test:api:dashboard": "npx playwright test tests/api/pnm_dashboard",
    "test:api:asset": "npx playwright test tests/api/pnm_asset --workers=2",
    "test:api:procurement": "npx playwright test tests/api/pnm_procurement --workers=2",
    "test:api:dpr": "npx playwright test tests/api/pnm_service_dpr --workers=2",
    "test:api:report": "npx playwright test tests/api/pnm_report --workers=2",
    "test:headed": "npx playwright test --headed",
    "test:debug": "npx playwright test --debug",
    "test:ui": "npx playwright test --ui",
    "report": "npx playwright show-report"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@playwright/test": "^1.50.0"
  },
  "dependencies": {
    "dotenv": "^16.4.5"
  }
}
